      "path": ".gitlab-ci.yml",
      "text": "workflow:\n  rules:\n    - if: $CI_COMMIT_TAG\n      when: always\n    - changes: [\"*.txt\"]\n      when: never\n    - when: always\n\nstages: [build, docs, check]\n\ninclude:\n  - local: ci/docs.yml\n    rules:\n      - changes: [\"docs/**/*\"]\n  - local: ci/never.yml\n    rules:\n      - changes: [\"nothing/**/*\"]\n\nbuild:\n  stage: build\n  script: [cargo build]\n  rules:\n    - changes: [\"src/**/*\"]\n\ndocs:\n  stage: docs\n  script: [mkdocs build]\n  rules:\n    - changes: [\"docs/**/*.{md,rst}\"]\n\nlint-yaml:\n  stage: check\n  script: [yamllint .]\n  rules:\n    - changes: [\"**/*.{yml,yaml}{,.*}\"]\n\nnever-first:\n  stage: check\n  script: [echo never-first]\n  rules:\n    - changes: [\"scripts/*\"]\n      when: never\n    - when: on_success\n\ndocs-vs-release:\n  stage: docs\n  script: [echo docs-vs-release]\n  rules:\n    - changes:\n        paths: [\"docs/**/*\"]\n        compare_to: release\n\nqmark:\n  stage: check\n  script: [echo qmark]\n  rules:\n    - changes: [\"src/main.??\"]\n\nclass:\n  stage: check\n  script: [echo class]\n  rules:\n    - changes: [\"scripts/[a-c]*.sh\"]\n\ndotmatch:\n  stage: check\n  script: [echo dotmatch]\n  rules:\n    - changes: [\"**/config\"]\n\nslash:\n  stage: check\n  script: [echo slash]\n  rules:\n    - changes: [\"/src/main.rs\"]\n\nvar-pattern:\n  stage: check\n  variables:\n    SRC_DIR: src\n  script: [echo var-pattern]\n  rules:\n    - changes: [\"$SRC_DIR/**/*\"]\n\nunknown-var:\n  stage: check\n  script: [echo unknown-var]\n  rules:\n    - changes: [\"$UNKNOWN_DIR/**/*\"]\n\nbare-star:\n  stage: docs\n  script: [echo bare-star]\n  rules:\n    - changes: [\"docs/**\"]\n"
    },
