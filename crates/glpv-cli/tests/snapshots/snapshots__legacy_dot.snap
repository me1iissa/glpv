      "p-cbe95be259861ccd/release" [label="release" peripheries=2 tooltip="stage: deploy"];
      "p-cbe95be259861ccd/old-style" [label="old-style" fillcolor="#fff8c5" tooltip="stage: deploy"];
    }
    "p-cbe95be259861ccd/compile" -> "p-cbe95be259861ccd/release" [style=invis weight=100];
