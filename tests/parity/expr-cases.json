    {
      "id": "re-U-flag",
      "expr": "$CI_COMMIT_BRANCH =~ /m.*n/U",
      "result": "true",
      "notes": [],
      "why": "U swaps greediness; it never changes whether a match exists"
    },
    {
      "id": "re-inline-i",
      "expr": "$CI_COMMIT_BRANCH =~ /(?i)MAIN/",
      "result": "true",
      "notes": []
    },
    {
      "id": "re-anchors-Az",
