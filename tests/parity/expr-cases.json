{
  "$comment": "Single source of truth for rules:if expression semantics. Consumed by crates/glpv-core/src/rules/expr.rs (parity_cases) and ui/test/parity.test.mjs. vars: name -> [\"known\", value] | [\"unset\"] | [\"unknown\"]. Per case: result in true|false|unknown; notes compared exactly; vars_used (optional) compared as [name, state_text] pairs; vars (optional) patches the table for that case.",
  "vars": {
    "CI_COMMIT_BRANCH": [
      "known",
      "main"
    ],
    "CI_DEFAULT_BRANCH": [
      "known",
      "main"
    ],
    "CI_PIPELINE_SOURCE": [
      "known",
      "push"
    ],
    "EMPTY": [
      "known",
      ""
    ],
    "NEL": [
      "known",
      "\u0085"
    ],
    "BOM": [
      "known",
      "\ufeff"
    ],
    "PATHY": [
      "known",
      "a/b"
    ],
    "PAT": [
      "known",
      "/^ma/i"
    ],
    "SLASH": [
      "known",
      "/"
    ],
    "BADPAT": [
      "known",
      "/a/x"
    ],
    "CI_COMMIT_TAG": [
      "unset"
    ],
    "MYSTERY": [
      "unknown"
    ]
  },
  "cases": [
    {
      "id": "cmp-eq-str",
      "expr": "$CI_COMMIT_BRANCH == \"main\"",
      "result": "true",
      "notes": [],
      "vars_used": [
        [
          "CI_COMMIT_BRANCH",
          "\"main\""
        ]
      ]
    },
    {
      "id": "cmp-ne-str",
      "expr": "$CI_COMMIT_BRANCH != \"main\"",
      "result": "false",
      "notes": []
    },
    {
      "id": "cmp-var-var",
      "expr": "$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH",
      "result": "true",
      "notes": [],
      "vars_used": [
        [
          "CI_COMMIT_BRANCH",
          "\"main\""
        ],
        [
          "CI_DEFAULT_BRANCH",
          "\"main\""
        ]
      ]
    },
    {
      "id": "cmp-unset-null",
      "expr": "$CI_COMMIT_TAG == null",
      "result": "true",
      "notes": [],
      "vars_used": [
        [
          "CI_COMMIT_TAG",
          "unset"
        ]
      ]
    },
    {
      "id": "cmp-str-null",
      "expr": "$CI_COMMIT_BRANCH == null",
      "result": "false",
      "notes": []
    },
    {
      "id": "cmp-str-bool",
      "expr": "$CI_COMMIT_BRANCH == true",
      "result": "false",
      "notes": [],
      "why": "Ruby == across types is false"
    },
    {
      "id": "presence-known",
      "expr": "$CI_COMMIT_BRANCH",
      "result": "true",
      "notes": []
    },
    {
      "id": "presence-unset",
      "expr": "$CI_COMMIT_TAG",
      "result": "false",
      "notes": [],
      "why": "unset variable"
    },
    {
      "id": "presence-blank",
      "expr": "$EMPTY",
      "result": "false",
      "notes": [],
      "vars_used": [
        [
          "EMPTY",
          "\"\""
        ]
      ],
      "why": "blank string fails present?"
    },
    {
      "id": "presence-unknown",
      "expr": "$MYSTERY",
      "result": "unknown",
      "notes": [],
      "vars_used": [
        [
          "MYSTERY",
          "unknown"
        ]
      ]
    },
    {
      "id": "bool-and-true",
      "expr": "$CI_COMMIT_BRANCH && $CI_PIPELINE_SOURCE == \"push\"",
      "result": "true",
      "notes": []
    },
    {
      "id": "bool-and-unset",
      "expr": "$CI_COMMIT_TAG && $CI_COMMIT_BRANCH",
      "result": "false",
      "notes": []
    },
    {
      "id": "bool-or-unset",
      "expr": "$CI_COMMIT_TAG || $CI_COMMIT_BRANCH",
      "result": "true",
      "notes": []
    },
    {
      "id": "bool-or-empty-then-blank",
      "expr": "$EMPTY || $CI_COMMIT_BRANCH",
      "result": "false",
      "notes": [],
      "why": "\"\" is truthy for ||, but the returned \"\" then fails present?"
    },
    {
      "id": "bool-or-unknown",
      "expr": "$MYSTERY || $CI_COMMIT_BRANCH",
      "result": "unknown",
      "notes": []
    },
    {
      "id": "bool-not-unset",
      "expr": "!$CI_COMMIT_TAG",
      "result": "true",
      "notes": []
    },
    {
      "id": "bool-not-empty",
      "expr": "!$EMPTY",
      "result": "false",
      "notes": [],
      "why": "! uses Ruby truthiness, not present?"
    },
    {
      "id": "prec-parens",
      "expr": "($CI_COMMIT_TAG || $CI_COMMIT_BRANCH == \"main\") && $CI_PIPELINE_SOURCE == \"push\"",
      "result": "true",
      "notes": []
    },
    {
      "id": "prec-and-tighter",
      "expr": "$CI_COMMIT_TAG && $MYSTERY || $CI_COMMIT_BRANCH == \"main\"",
      "result": "true",
      "notes": [],
      "why": "&& binds tighter than ||"
    },
    {
      "id": "re-prefix",
      "expr": "$CI_COMMIT_BRANCH =~ /^ma/",
      "result": "true",
      "notes": []
    },
    {
      "id": "re-flag-i",
      "expr": "$CI_COMMIT_BRANCH =~ /^MA/i",
      "result": "true",
      "notes": []
    },
    {
      "id": "re-notmatch",
      "expr": "$CI_COMMIT_BRANCH !~ /release/",
      "result": "true",
      "notes": []
    },
    {
      "id": "re-nil-coerces",
      "expr": "$CI_COMMIT_TAG =~ /x/",
      "result": "false",
      "notes": [],
      "why": "nil coerces to \"\" on the left"
    },
    {
      "id": "re-nil-empty-anchor",
      "expr": "$CI_COMMIT_TAG =~ /^$/",
      "result": "true",
      "notes": []
    },
    {
      "id": "re-rhs-str",
      "expr": "$CI_COMMIT_BRANCH =~ \"main\"",
      "result": "false",
      "notes": [
        "the right side of =~ is not a /regex/; GitLab treats the match as false"
      ],
      "vars_used": [
        [
          "CI_COMMIT_BRANCH",
          "\"main\""
        ]
      ]
    },
    {
      "id": "re-lhs-unknown",
      "expr": "$MYSTERY =~ /x/",
      "result": "unknown",
      "notes": [],
      "vars_used": [
        [
          "MYSTERY",
          "unknown"
        ]
      ]
    },
    {
      "id": "syntax-trailing-op",
      "expr": "$CI_COMMIT_BRANCH ==",
      "result": "false",
      "notes": [],
      "why": "parses; the missing operand pops as nil"
    },
    {
      "id": "syntax-open-parens",
      "expr": "(((",
      "result": "false",
      "notes": [
        "expression does not parse (unbalanced parentheses); GitLab evaluates it as false"
      ]
    },
    {
      "id": "syntax-junk",
      "expr": "bogus tokens",
      "result": "false",
      "notes": [
        "expression does not parse (unexpected character `b`); GitLab evaluates it as false"
      ]
    },
    {
      "id": "syntax-empty",
      "expr": "",
      "result": "false",
      "notes": [
        "expression does not parse (empty expression); GitLab evaluates it as false"
      ]
    },
    {
      "id": "varsused-order",
      "expr": "$CI_COMMIT_TAG || $MYSTERY",
      "result": "unknown",
      "notes": [],
      "vars_used": [
        [
          "CI_COMMIT_TAG",
          "unset"
        ],
        [
          "MYSTERY",
          "unknown"
        ]
      ]
    },
    {
      "id": "re-lookahead",
      "expr": "$CI_COMMIT_BRANCH =~ /(?=x)/",
      "result": "false",
      "notes": [
        "invalid regex /(?=x)/; GitLab evaluates the rule as false"
      ]
    },
    {
      "id": "re-neg-lookahead",
      "expr": "$CI_COMMIT_BRANCH =~ /(?!x)/",
      "result": "false",
      "notes": [
        "invalid regex /(?!x)/; GitLab evaluates the rule as false"
      ]
    },
    {
      "id": "re-lookbehind",
      "expr": "$CI_COMMIT_BRANCH =~ /(?<=m)a/",
      "result": "false",
      "notes": [
        "invalid regex /(?<=m)a/; GitLab evaluates the rule as false"
      ]
    },
    {
      "id": "re-backref",
      "expr": "$CI_COMMIT_BRANCH =~ /(a)\\1/",
      "result": "false",
      "notes": [
        "invalid regex /(a)\\1/; GitLab evaluates the rule as false"
      ]
    },
    {
      "id": "re-named-backref",
      "expr": "$CI_COMMIT_BRANCH =~ /(?<x>a)\\k<x>/",
