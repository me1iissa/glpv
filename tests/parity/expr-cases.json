    },
    {
      "id": "syntax-101-tokens",
      "expr": "$A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A ",
      "result": "false",
      "notes": [
        "expression does not parse (more than 100 tokens); GitLab evaluates it as false"
      ],
      "why": "the limit trips when input remains after the 101st token"
    },
    {
      "id": "syntax-101-tokens-no-trailing",
      "expr": "$A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A || $A",
      "result": "unknown",
      "notes": [],
