      ]
    },
    {
      "id": "syntax-unbalanced-open",
      "expr": "($CI_COMMIT_BRANCH",
      "result": "false",
      "notes": [
        "expression does not parse (unbalanced parentheses); GitLab evaluates it as false"
      ]
    },
    {
      "id": "syntax-smart-quotes",
      "expr": "$CI_COMMIT_BRANCH == \u201cmain\u201d",
