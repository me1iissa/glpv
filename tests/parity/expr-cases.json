      "notes": []
    },
    {
      "id": "re-named-P",
      "expr": "$CI_COMMIT_BRANCH =~ /(?P<x>ma)in/",
      "result": "true",
      "notes": []
    },
    {
      "id": "re-escaped-slash",
      "expr": "$PATHY =~ /a\\/b/",
      "result": "true",
