    },
    {
      "id": "re-rhs-unknown",
      "expr": "$CI_COMMIT_BRANCH =~ $MYSTERY",
      "result": "unknown",
      "notes": []
    },
    {
      "id": "re-lhs-unknown-invalid-rhs",
      "expr": "$MYSTERY =~ /(?=x)/",
